<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulutga zaxira va qurilmadan-qurilmaga ko'chirish. Faqat quyidagilar; boshqa hamma narsa (cache, Game Boost asl qiymatlari va h.k.) chiqarib tashlanadi. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="history.json" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="automation.xml" />
        <include domain="sharedpref" path="onboarding.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="history.json" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="automation.xml" />
        <include domain="sharedpref" path="onboarding.xml" />
    </device-transfer>
</data-extraction-rules>
